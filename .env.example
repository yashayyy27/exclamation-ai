# No credentials required for offline mode.
# Optional server-only integrations. Never prefix secrets with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_MAX_BYTES=1000000000
API_ACCESS_TOKEN=
# Public, non-secret container ID. Collection stays disabled until consent.
VITE_GTM_ID=
# Local API mode: requires local server and bearer token at request time.
VITE_API_URL=

# Explicit owner approval; keep disabled until a bounded run is approved.
OWNER_ALLOW_PAID_CALLS=0
